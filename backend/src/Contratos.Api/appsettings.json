{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CnpjApi": {
    "BrasilApi": {
      "BaseUrl": "https://brasilapi.com.br/api/cnpj/v1/"
    }
  },
  "Documentos": {
    "CaminhoTemplate": "../../../templates/contratos/modelo.docx"
  },
  "Armazenamento": {
    "PastaContratosGerados": ""
  },
  "Pdf": {
    "CaminhoExecutavelLibreOffice": "C:\\Program Files\\LibreOffice\\program\\soffice.exe",
    "TimeoutSegundos": 30
  },
  "RateLimiting": {
    "ConsultaCnpj": {
      "PermiteConsultas": 30,
      "JanelaSegundos": 60
    }
  },
  "AllowedHosts": "*"
}